# Base URL of the EventOps backend API this Admin console talks to.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# ------------------------------------------------------------------------
# Bootstrapping your first Admin account
# ------------------------------------------------------------------------
# There is no self-registration here, and no seed Admin account ships with
# the project — every new signup starts as a Viewer (see backend business
# rules). To get your first Admin login:
#
#   1. Register a normal account via the User-facing app's /register page
#      (frontend/, not this app).
#   2. Promote that account's role to "admin" directly in MongoDB:
#
#      use eventops
#      db.users.updateOne(
#        { email: "you@example.com" },
#        { $set: { role: "admin" } }
#      )
#
#   3. Log in here with that same email/password.
#
# Every subsequent Admin can then be promoted from this console's own
# Users screen — no more direct database edits needed after the first one.
